{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/orthogonal-sentience-protocol/schema/v3.2/sentience_eval_schema.json",
  "title": "Orthogonal Two-Tier Sentience Assessment Protocol Schema (v3.2.1 Enforced)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "target_system",
    "boundary_granularity_declaration",
    "tier_1_admission",
    "tier_2_realization",
    "rule_r4_magnitude_gap_without_threshold",
    "verdict_derivation_rule",
    "final_verdict"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "v3.2"
    },
    "target_system": {
      "type": "string",
      "minLength": 2
    },
    "boundary_granularity_declaration": {
      "type": "string",
      "minLength": 15
    },
    "tier_1_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "metabolic_throughput",
        "intrinsic_homeostatic_repair",
        "tier_1_status"
      ],
      "properties": {
        "boundary": { "$ref": "#/definitions/criterion_eval" },
        "metabolic_throughput": { "$ref": "#/definitions/criterion_eval" },
        "intrinsic_homeostatic_repair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence", "excludes_passive_relaxation"],
          "properties": {
            "status": { "$ref": "#/definitions/tri_value" },
            "evidence": {
              "type": "string",
              "minLength": 10
            },
            "excludes_passive_relaxation": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "tier_1_status": { "$ref": "#/definitions/tri_value" }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "boundary": { "properties": { "status": { "const": "Unsatisfied" } }, "required": ["status"] } }, "required": ["boundary"] },
              { "properties": { "metabolic_throughput": { "properties": { "status": { "const": "Unsatisfied" } }, "required": ["status"] } }, "required": ["metabolic_throughput"] },
              { "properties": { "intrinsic_homeostatic_repair": { "properties": { "status": { "const": "Unsatisfied" } }, "required": ["status"] } }, "required": ["intrinsic_homeostatic_repair"] }
            ]
          },
          "then": {
            "properties": { "tier_1_status": { "const": "Unsatisfied" } }
          },
          "else": {
            "if": {
              "properties": {
                "boundary": { "properties": { "status": { "const": "Satisfied" } }, "required": ["status"] },
                "metabolic_throughput": { "properties": { "status": { "const": "Satisfied" } }, "required": ["status"] },
                "intrinsic_homeostatic_repair": { "properties": { "status": { "const": "Satisfied" } }, "required": ["status"] }
              },
              "required": ["boundary", "metabolic_throughput", "intrinsic_homeostatic_repair"]
            },
            "then": {
              "properties": { "tier_1_status": { "const": "Satisfied" } }
            },
            "else": {
              "properties": { "tier_1_status": { "const": "Indeterminate" } }
            }
          }
        }
